
import random
from itertools import count
from enum import Enum


INPUT_FILE = "processes.txt"
OUTPUT_LOG = "process_log.txt"


class ProcessState(Enum):
    CREATED = "new"
    QUEUED = "ready"
    EXECUTING = "running"
    BLOCKED = "waiting"
    FINISHED = "terminated"


class ProcessControlBlock:
    id_generator = count(1)

    def __init__(self, process_name, cpu_time):
        self.process_id = next(self.id_generator)
        self.process_name = process_name
        self.cpu_time = int(cpu_time)
        self.time_left = self.cpu_time
        self.current_state = ProcessState.CREATED
        self.state_history = [ProcessState.CREATED]

    def change_state(self, target_state, log_file=None):
        previous = self.current_state
        self.current_state = target_state
        self.state_history.append(target_state)

        record = (
            f"PID {self.process_id} | "
            f"{self.process_name:<12} | "
            f"{previous.value:<10} -> {target_state.value}"
        )

        print(record)

        if log_file is not None:
            log_file.write(record + "\n")


def allocate_processes():
    print("=== PROCESS ALLOCATION ===")

    try:
        total = int(input("Number of processes to create: "))
    except ValueError:
        print("Invalid number of processes.")
        return

    with open(INPUT_FILE, "w") as file:
        for number in range(1, total + 1):
            print(f"\nCreating PCB #{number}")

            process_name = input("Process name: ").strip()
            cpu_time = input("Required CPU burst time: ").strip()

            file.write(f"{process_name},{cpu_time}\n")

            print(
                f"PCB created for {process_name}. "
                "Process ID will be generated when loaded."
            )

    print(f"\nProcess information stored in '{INPUT_FILE}'.\n")


def retrieve_processes():
    process_list = []

    try:
        with open(INPUT_FILE, "r") as file:
            for entry in file:
                entry = entry.strip()

                if not entry:
                    continue

                parts = entry.split(",")

                if len(parts) != 2:
                    continue

                process_name, cpu_time = parts

                pcb = ProcessControlBlock(process_name, cpu_time)
                process_list.append(pcb)

                print(
                    f"Process loaded: PID {pcb.process_id} | "
                    f"{pcb.process_name} | "
                    f"Burst = {pcb.cpu_time}"
                )

    except FileNotFoundError:
        print(f"Unable to locate '{INPUT_FILE}'.")
        return []

    return process_list


def arrange_processes(process_list):
    print("\n=== CPU SCHEDULING: SHORTEST JOB FIRST ===")

    sorted_list = sorted(
        process_list,
        key=lambda process: process.cpu_time
    )

    print("Execution order:")

    for process in sorted_list:
        print(
            f"PID {process.process_id} - "
            f"{process.process_name} "
            f"({process.cpu_time} CPU units)"
        )

    return sorted_list


def execute_cpu_simulation(process_list, time_slice=1):

    ready = []
    blocked = []

    with open(OUTPUT_LOG, "w") as log_file:

        title = "=== PROCESS STATE SIMULATION ==="
        print(title)

        log_file.write(title + "\n")
        log_file.write(
            "State flow: NEW -> READY -> RUNNING -> "
            "WAITING -> TERMINATED\n"
        )

        # Place all newly created processes into the ready queue.
        for process in process_list:
            process.change_state(ProcessState.QUEUED, log_file)
            ready.append(process)

        print("\n=== CPU EXECUTION AND CONTEXT SWITCHING ===")
        log_file.write("\n=== CPU EXECUTION AND CONTEXT SWITCHING ===\n")

        while ready or blocked:

            # Give blocked processes a chance to return to the ready queue.
            for process in blocked[:]:
                if random.random() < 0.5:
                    blocked.remove(process)
                    process.change_state(ProcessState.QUEUED, log_file)
                    ready.append(process)

            # If no process is currently ready, check again.
            if not ready:
                continue

            active_process = ready.pop(0)

            active_process.change_state(
                ProcessState.EXECUTING,
                log_file
            )

            execution_time = min(
                time_slice,
                active_process.time_left
            )

            active_process.time_left -= execution_time

            execution_message = (
                f"    CPU executed {active_process.process_name} "
                f"for {execution_time} unit(s); "
                f"{active_process.time_left} unit(s) left."
            )

            print(execution_message)
            log_file.write(execution_message + "\n")

            # Determine the next state of the process.
            if active_process.time_left == 0:

                active_process.change_state(
                    ProcessState.FINISHED,
                    log_file
                )

            elif random.random() < 0.4:

                active_process.change_state(
                    ProcessState.BLOCKED,
                    log_file
                )

                blocked.append(active_process)

                message = (
                    "    Process is waiting for I/O "
                    "and has entered the waiting queue."
                )

                print(message)
                log_file.write(message + "\n")

            else:

                active_process.change_state(
                    ProcessState.QUEUED,
                    log_file
                )

                ready.append(active_process)

                switch_message = (
                    "    Context switch: CPU proceeds "
                    "to another ready process."
                )

                print(switch_message)
                log_file.write(switch_message + "\n")

    print(f"\nSimulation completed. Log saved to '{OUTPUT_LOG}'.")


def display_results(process_list):

    print("\n=== PROCESS EXECUTION SUMMARY ===")

    for process in process_list:

        states = " -> ".join(
            state.value for state in process.state_history
        )

        print(
            f"PID {process.process_id} "
            f"({process.process_name}): {states}"
        )


def main():

    # Step 1: Create and save process information.
    allocate_processes()

    # Step 2: Load process information into PCB objects.
    processes = retrieve_processes()

    if not processes:
        print("No processes available for simulation.")
        return

    # Step 3: Determine execution order using SJF.
    execution_order = arrange_processes(processes)

    # Step 4: Simulate process execution and context switching.
    execute_cpu_simulation(execution_order)

    # Step 5: Display the state history of every process.
    display_results(execution_order)


if __name__ == "__main__":
    main()
